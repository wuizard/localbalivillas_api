# Which config app/config/index.js loads. No default - the process refuses to
# start without it, because the environments differ in database, payment key,
# signing secret and whether real guests are emailed.
APP_ENV=staging

# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- S3 uploads (required for the CMS image uploader) ---
# The IAM user needs only s3:PutObject on the bucket below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
# Production MUST set this. config-prod has no fallback, so presign fails loudly
# rather than quietly writing production photos into the staging bucket.
AWS_S3_BUCKET=sstaging-localbalivilla
AWS_S3_PREFIX=lbv

# --- Database, session signing, payments (all required) ---
# Both config-prod and config-staging read these with no fallback, so the
# process refuses to start until they are set. Each deployment gets its own
# .env - the value here decides which database and which Xendit account you
# are pointed at, not the config file you loaded in server.js.

# mongodb+srv://<user>:<pass>@lbv.o0jzr.mongodb.net/<production|staging>?ssl=true&retryWrites=true&w=majority
MONGO_DB_URL=

# Signs and verifies the admin JWT - load-bearing for auth, not a placeholder.
# Long and random, and different per environment: a shared value means a staging
# token opens production. Changing it signs every admin out, which is the lever to
# pull if a token leaks.
SESSION_SECRET=

# xnd_production_... in prod, xnd_development_... in staging.
XENDIT_SECRET_API_KEY=

# Mail. Required in production; staging never sends (sendEmail returns early).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma separated. Copied on booking and enquiry notifications.
SMTP_CC=
